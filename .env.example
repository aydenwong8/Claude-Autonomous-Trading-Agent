# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Loaded by agent.py's load_dotenv() at import; run_daily.sh cds into the
# project first so this file is found relative to the project root.

# Anthropic API key for the decision engine (config.CLAUDE_MODEL).
# Read implicitly by the anthropic SDK client, so the name must match exactly.
# Get one at https://console.anthropic.com/settings/keys — this is pay-as-you-go
# billing, separate from any Claude.ai subscription.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Alpaca API key/secret. Used for trading, market data, and news.
# Paper and live are SEPARATE key pairs — generate paper keys at
# https://app.alpaca.markets/paper/dashboard/overview and live keys from the
# live dashboard. Whichever pair is in .env determines which account is real.
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# There is deliberately no ALPACA_PAPER setting here. Paper vs. live is chosen
# by the --mode flag (default "paper"; run_daily.sh hardcodes paper), and live
# mode is additionally locked behind config.LIVE_UNLOCK_ENV. A second, unread
# paper/live switch in this file would read like a safety control while doing
# nothing — the lock below is the real one.
#
# To run live (Phase 2), set this in the shell for that one command — never
# here, so it can't be picked up silently by a scheduled run:
#   TRADING_AGENT_ALLOW_LIVE=yes-trade-real-money python agent.py --mode live

# Fundamentals (fundamentals.py). Finnhub free tier: https://finnhub.io
FINNHUB_API_KEY=
# The SEC requires contact details in every request's User-Agent:
# "<project name> <email you choose>". Without it, EDGAR data is flagged as a
# failed lookup for every name.
SEC_USER_AGENT=
